{
  "name": "lifepilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.ts *.mjs *.json README.md",
    "format": "prettier --write src tests *.ts *.mjs *.json README.md",
    "test:db": "node scripts/test-db.mjs",
    "test:caldav": "node scripts/test-caldav.mjs",
    "pretest:local": "npm run build",
    "test:local": "node --import tsx scripts/test-local.ts",
    "smoke:local": "node --import tsx scripts/test-local.ts --live",
    "pretest:e2e": "npm run build"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@next/env": "^16.4.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tsdav": "^2.5.0",
    "tsx": "^4.23.15",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
