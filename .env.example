NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for validated state mutations and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Optional; defaults to 45 seconds.
AI_TIMEOUT_MS=45000
# Output budget for detailed decision trees. Chat uses a smaller separate budget.
AI_MAX_OUTPUT_TOKENS=16000
# Optional provider-specific reasoning effort: none|minimal|low|medium|high|xhigh|max
# AI_REASONING_EFFORT=low
# Optional for models that support forced function calls; default is text JSON.
# AI_JSON_MODE=tool
# Local mode: LIFEPILOT_MODE=local; LOCAL_DATA_DIR is optional.
# LIFEPILOT_MODE=local
# LOCAL_DATA_DIR=/path/to/lifepilot-data
# Test server only; permits HTTP exclusively on this loopback origin.
# LOCAL_CALDAV_HTTP_URL=http://127.0.0.1:5232
